# Copy to .env for local runs. On Netlify set the same names as site
# environment variables instead (`netlify env:set NAME value`) -- values in
# netlify.toml are build-scope only and would not reach the functions.

# --- required ---------------------------------------------------------------

# Netlify personal access token: User settings > Applications > Personal access
# tokens. NETLIFY_AUTH_TOKEN works too; it is the name the Netlify CLI uses.
NETLIFY_TOKEN=

# --- deployment -------------------------------------------------------------

# Day boundaries are local-time, so this decides which day a pageview lands in.
# Netlify runs UTC; set it to the zone your existing history was collected in
# or days will straddle the boundary differently before and after the move.
# TZ=America/Los_Angeles

# HTTP Basic auth in front of the whole site. Unset means no password at all,
# which on a public URL means anyone can read your traffic numbers.
# DASHBOARD_PASSWORD=
# DASHBOARD_USER=admin

# Shared secret the scheduled job presents to the background sync, so the job
# cannot be triggered by anyone who guesses the URL.
# CRON_SECRET=

# Needed only by `npm run seed` (copying history to/from the deployed site).
# NETLIFY_SITE_ID=

# --- storage ----------------------------------------------------------------

# file  = JSON under DATA_DIR (default for local runs)
# blobs = Netlify Blobs (default on Netlify; nothing else survives a deploy)
# STORE=
# BLOBS_STORE=netlify-analytics
# DATA_DIR=data

# --- server -----------------------------------------------------------------

# PORT=3000
# HOST=127.0.0.1

# --- sync -------------------------------------------------------------------

# Days of history to request per sync. Netlify serves at most 30.
# SYNC_DAYS=30
# Re-sync on server start when the last sync is older than this many minutes.
# STALE_MINUTES=60
# Projects fetched at once. Each project costs 8 analytics requests.
# CONCURRENCY=4
# Rows kept per ranking (top pages, sources, countries, 404s).
# RANKING_LIMIT=100

# Which projects to sync. Comma-separated, * is a wildcard, case-insensitive.
# An empty SITE_INCLUDE means every project. Excluded projects cost no requests.
# SITE_INCLUDE=
# SITE_EXCLUDE=test-*,*-scratch

# --- dashboard --------------------------------------------------------------

# DASHBOARD_TITLE=Netlify Analytics
# Date-range buttons, in days. 0 means "all history".
# DASHBOARD_RANGES=7,30,90,365,0
# DASHBOARD_DEFAULT_RANGE=30
# Rows shown in each top-list card.
# DASHBOARD_RANK_ROWS=10
# Beyond this span daily points are grouped into weeks, to keep charts readable.
# DASHBOARD_WEEKLY_AFTER_DAYS=92
